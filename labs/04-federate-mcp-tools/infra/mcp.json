{
  "inputs": [
    {
      "type": "promptString",
      "id": "aigw-key",
      "description": "AI Gateway runtime key (Access > Keys)",
      "password": true
    }
  ],
  "servers": {
    "ai-gateway-learn": {
      "type": "http",
      "url": "https://<gateway>.azure-api.net/default/toolservers/learn/mcp",
      "headers": {
        "api-key": "${input:aigw-key}"
      }
    }
  }
}
