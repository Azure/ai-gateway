subscription_id  = "00000000-0000-0000-0000-000000000000"
environment_name = "aigateway"
location         = "eastus2"
gateway_location = "eastus2"
publisher_email  = "platform@example.com"

# Optional additive Access configuration, independent of Public/Private-only.
# Uses Entra object IDs, not application/client IDs. Empty by default.
# Grants model invocation across this gateway; does not revoke API keys.
# gateway_access_principals = {
#   application = {
#     principal_id   = "<managed-identity-or-service-principal-object-id>"
#     principal_type = "ServicePrincipal"
#   }
# }

# Public is the default; select profiles/private-only.tfvars.json for the final private posture.
# profiles/private-connectivity.tfvars.json is an intermediate provisioning stage only.
# See deployment.md before staging; never reopen an already-private endpoint.
# enable_private_networking     = true
# gateway_public_network_access = "Enabled"
# models_public_network_access  = "Enabled"
# private_network_address_prefix = "10.247.0.0/16"
#
# Optional billable VM for private-path testing; no public IP or inbound access.
# enable_private_test_client         = true
# private_test_client_ssh_public_key = "ssh-ed25519 <your-public-key>"

# Examples, not a guarantee of regional availability or quota. Choose supported versions.
model_deployments = {
  gpt-mini = {
    model_name    = "gpt-4.1-mini"
    model_version = "2025-04-14"
    capacity      = 10
    token_limit   = 10000
  }
  gpt-full = {
    model_name    = "gpt-4.1"
    model_version = "2025-04-14"
    capacity      = 10
    token_limit   = 10000
  }
}
